# 岳阳学院智慧校园 —— 后端服务（uvicorn :8000）
#
# 使用前先按你的服务器改这两处：
#   1) WorkingDirectory  → 代码实际路径
#   2) ExecStart         → python3 和 uvicorn 的绝对路径，用 `which python3` 查
#
# 安装：
#   sudo cp scripts/systemd/campus-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now campus-backend
#
# 常用：
#   systemctl status  campus-backend
#   systemctl restart campus-backend
#   journalctl -u campus-backend -f

[Unit]
Description=Yueyang Campus Backend (uvicorn)
Documentation=http://127.0.0.1:8000/docs
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/project/campus-new/campus-new
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/project/campus-new/venv/bin/python3  -m uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
